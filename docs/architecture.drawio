<mxCell id="title" value="&lt;b&gt;HotelPulse — архитектура системы мониторинга эффективности отелей (клиент-серверная, 3 уровня)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=18;fontColor=#1f2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1100" height="36" as="geometry"/></mxCell>
