<mxCell id="t3" value="&lt;b&gt;Уровень данных&lt;/b&gt;" style="swimlane;startSize=30;horizontal=1;rounded=1;arcSize=2;html=1;whiteSpace=wrap;fontSize=12;swimlaneFillColor=#f0fdf4;fontColor=#1f2937;fillColor=#bbf7d0;strokeColor=#22c55e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1330" y="560" width="350" height="310" as="geometry"/></mxCell>
<mxCell id="c1" value="&lt;b&gt;Менеджер отеля (браузер)&lt;/b&gt;&lt;br&gt;вносит показатели, смотрит KPI" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f2937;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=2;" vertex="1" parent="t1"><mxGeometry x="20" y="70" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;Аналитик сети (браузер)&lt;/b&gt;&lt;br&gt;сравнивает отели, прогнозы" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f2937;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=2;" vertex="1" parent="t1"><mxGeometry x="20" y="200" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;Гость (браузер)&lt;/b&gt;&lt;br&gt;оставляет оценку и отзыв" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f2937;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=2;" vertex="1" parent="t1"><mxGeometry x="20" y="330" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;Администратор (браузер)&lt;/b&gt;&lt;br&gt;управляет отелями и доступом" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f2937;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=2;" vertex="1" parent="t1"><mxGeometry x="20" y="460" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="fe" value="&lt;b&gt;Frontend&lt;/b&gt;&lt;br&gt;React + TypeScript&lt;br&gt;(SPA в браузере)&lt;br&gt;&lt;br&gt;дашборды и графики,&lt;br&gt;формы показателей&lt;br&gt;и отзывов;&lt;br&gt;JWT-токен хранится&lt;br&gt;на стороне клиента" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;fillColor=#bfdbfe;strokeColor=#2563eb;strokeWidth=2;" vertex="1" parent="t1"><mxGeometry x="270" y="70" width="170" height="470" as="geometry"/></mxCell>
<mxCell id="gd" value="&lt;b&gt;Guards (JWT + RBAC)&lt;/b&gt;&lt;br&gt;проверяют токен и роль перед каждым Controller; менеджер — только свой отель" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f2937;fillColor=#bbf7d0;strokeColor=#16a34a;strokeWidth=2;" vertex="1" parent="t2"><mxGeometry x="30" y="50" width="630" height="55" as="geometry"/></mxCell>
