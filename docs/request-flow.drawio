<mxfile host="app.diagrams.net" type="device"><diagram name="Жизненный цикл запроса" id="Жизненный_цикл_запроса"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;Жизненный цикл запроса UC1: менеджер отеля вносит показатели за день — POST /api/v1/hotels/5/metrics&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=18;fontColor=#1f2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1500" height="36" as="geometry"/></mxCell>
<mxCell id="st" value="&lt;b&gt;Начало&lt;/b&gt;&lt;br&gt;(UC1)" style="ellipse;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;fillColor=#bbf7d0;strokeColor=#16a34a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="125" width="100" height="70" as="geometry"/></mxCell>
<mxCell id="s1" value="&lt;b&gt;1. Действие пользователя&lt;/b&gt;&lt;br&gt;Менеджер жмёт «Сохранить»&lt;br&gt;React: fetch() →&lt;br&gt;POST /api/v1/hotels/5/metrics" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f2937;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190" y="100" width="220" height="120" as="geometry"/></mxCell>
<mxCell id="s2" value="&lt;b&gt;2. DNS&lt;/b&gt;&lt;br&gt;hotelpulse.example →&lt;br&gt;IP-адрес сервера&lt;br&gt;(кэш браузера / ОС)" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f2937;fillColor=#e5e7eb;strokeColor=#6b7280;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="100" width="220" height="120" as="geometry"/></mxCell>
<mxCell id="s3" value="&lt;b&gt;3. TCP + TLS&lt;/b&gt;&lt;br&gt;рукопожатие, сертификат;&lt;br&gt;далее данные идут&lt;br&gt;в зашифрованном виде" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f2937;fillColor=#e5e7eb;strokeColor=#6b7280;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="770" y="100" width="220" height="120" as="geometry"/></mxCell>
<mxCell id="s4" value="&lt;b&gt;4. HTTP-запрос&lt;/b&gt;&lt;br&gt;POST /api/v1/hotels/5/metrics&lt;br&gt;Authorization: Bearer JWT&lt;br&gt;body: JSON с показателями" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f2937;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1060" y="100" width="220" height="120" as="geometry"/></mxCell>
<mxCell id="s5" value="&lt;b&gt;5. Приём запроса&lt;/b&gt;&lt;br&gt;Nginx (TLS) → NestJS :3000&lt;br&gt;направляет в Controller&lt;br&gt;модуля Metrics" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f2937;fillColor=#ddd6fe;strokeColor=#7c3aed;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1350" y="100" width="220" height="120" as="geometry"/></mxCell>
<mxCell id="s6" value="&lt;b&gt;6. Обработка в backend&lt;/b&gt;&lt;br&gt;Guard: JWT, роль manager,&lt;br&gt;отель №5 закреплён за ним;&lt;br&gt;Service: загрузка и RevPAR" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f2937;fillColor=#ddd6fe;strokeColor=#7c3aed;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1350" y="360" width="220" height="120" as="geometry"/></mxCell>
<mxCell id="s7" value="&lt;b&gt;7. Обращение к БД&lt;/b&gt;&lt;br&gt;Prisma, одна транзакция:&lt;br&gt;INSERT в daily_metrics,&lt;br&gt;SELECT порогов оповещений" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f2937;fillColor=#bbf7d0;strokeColor=#16a34a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1060" y="360" width="220" height="120" as="geometry"/></mxCell>
<mxCell id="s8" value="&lt;b&gt;8. Ответ&lt;/b&gt;&lt;br&gt;201 Created + JSON:&lt;br&gt;id, occupancyRate, revparSom&lt;br&gt;ошибки: 400 / 401 / 403 / 409" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f2937;fillColor=#ddd6fe;strokeColor=#7c3aed;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="770" y="360" width="220" height="120" as="geometry"/></mxCell>
<mxCell id="s9" value="&lt;b&gt;9. Обновление интерфейса&lt;/b&gt;&lt;br&gt;зелёное уведомление,&lt;br&gt;KPI-карточки и график&lt;br&gt;обновлены" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f2937;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="360" width="220" height="120" as="geometry"/></mxCell>
<mxCell id="en" value="&lt;b&gt;Конец&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;fillColor=#fecaca;strokeColor=#dc2626;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="250" y="385" width="110" height="70" as="geometry"/></mxCell>
<mxCell id="th1" value="&lt;b&gt;hotels&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;fillColor=#15803d;strokeColor=#15803d;strokeWidth=2;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="520" y="570" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="tb1" value="id  (PK)&lt;br&gt;name, city, stars&lt;br&gt;rooms_total  ← проверка лимита&lt;br&gt;manager_id  (FK → users)  ← права" style="rounded=0;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f2937;fillColor=#f0fdf4;strokeColor=#15803d;strokeWidth=2;align=left;spacingLeft=8;verticalAlign=top;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="520" y="600" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="th2" value="&lt;b&gt;daily_metrics&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;fillColor=#1d4ed8;strokeColor=#1d4ed8;strokeWidth=2;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="890" y="570" width="380" height="30" as="geometry"/></mxCell>
<mxCell id="tb2" value="id  (PK)&lt;br&gt;hotel_id  (FK → hotels)&lt;br&gt;date        UNIQUE (hotel_id, date)&lt;br&gt;rooms_occupied   CHECK 0 ≤ x ≤ rooms_total&lt;br&gt;adr_som, marketing_spend_som, cancel_rate&lt;br&gt;revenue_som   ← INSERT новой строки" style="rounded=0;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f2937;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;align=left;spacingLeft=8;verticalAlign=top;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="890" y="600" width="380" height="170" as="geometry"/></mxCell>
<mxCell id="th3" value="&lt;b&gt;alert_rules&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1f2937;fillColor=#b45309;strokeColor=#b45309;strokeWidth=2;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1330" y="570" width="340" height="30" as="geometry"/></mxCell>
<mxCell id="tb3" value="id  (PK)&lt;br&gt;hotel_id  (FK → hotels)&lt;br&gt;metric  (occupancy / rating)&lt;br&gt;threshold  ← сравнение с новым значением" style="rounded=0;html=1;whiteSpace=wrap;fontSize=11;fontColor=#1f2937;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;align=left;spacingLeft=8;verticalAlign=top;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1330" y="600" width="340" height="120" as="geometry"/></mxCell>
<mxCell id="lg" value="Стрелки сверху вниз и справа налево — путь запроса и ответа; таблицы показывают, к каким данным обращается backend на шаге 7." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#374151;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="765" width="1650" height="30" as="geometry"/></mxCell>
